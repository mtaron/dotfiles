{{ if eq .osid "linux-ubuntu" -}}
{{- $miseVersion := (gitHubLatestRelease "jdx/mise").TagName -}}
{{- $archMise := ternary "x64" .chezmoi.arch (eq .chezmoi.arch "amd64") }}
.local/bin/mise:
  type: file
  url: https://github.com/jdx/mise/releases/download/{{ $miseVersion }}/mise-{{ $miseVersion }}-linux-{{ $archMise }}
  executable: true

.local/share/zsh/plugins/zsh-syntax-highlighting:
  type: archive
  url: https://github.com/zsh-users/zsh-syntax-highlighting/archive/master.tar.gz
  exact: true
  stripComponents: 1
  refreshPeriod: 168h
  include:
  - '*/*.zsh'
  - '*/.version'
  - '*/.revision-hash'
  - '*/highlighters/**'

.local/share/zsh/plugins/zsh-autosuggestions:
  type: archive
  url: https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz
  exact: true
  stripComponents: 1
  refreshPeriod: 168h

.local/share/zsh/plugins/zsh-shift-select/zsh-shift-select.plugin.zsh:
  type: file
  url: https://raw.githubusercontent.com/jirutka/zsh-shift-select/refs/heads/master/zsh-shift-select.plugin.zsh
  refreshPeriod: 168h

.local/share/zsh/plugins/zsh-autopair/autopair.zsh:
  type: file
  url: https://raw.githubusercontent.com/hlissner/zsh-autopair/refs/heads/master/autopair.zsh
  refreshPeriod: 168h

{{   if not .headless -}}
# script to remove old linux kernels so /boot doesn't fill up
kernel-clean:
  type: file
  url: "https://raw.githubusercontent.com/plepe/kernel-clean/master/kernel-clean"
  executable: true
  refreshPeriod: "744h"
{{   end -}}
{{- end }}
