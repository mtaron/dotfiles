# Versions and checksums live in .chezmoidata/externals.yaml so they can be updated easily by the update.zsh script.

{{- with .externals.zgenom }}
.local/share/zgenom:
  type: archive
  url: https://github.com/jandamm/zgenom/archive/{{ .version }}.tar.gz
  stripComponents: 1
  checksum:
    sha256: {{ .sha256 | quote }}
{{- end }}

{{- with .externals.ohmyzsh }}
.local/share/oh-my-zsh:
  type: archive
  url: https://github.com/ohmyzsh/ohmyzsh/archive/{{ .version }}.tar.gz
  stripComponents: 1
  checksum:
    sha256: {{ .sha256 | quote }}
  exclude:
    - "*/themes"
    - "*/templates"
    - "*/.github"
    - "*/.devcontainer"
{{- end }}

{{ if eq .osid "linux-ubuntu" -}}
{{- with .externals.mise }}
.local/bin/mise:
  type: file
  url: https://github.com/jdx/mise/releases/download/{{ .version }}/mise-{{ .version }}-linux-x64
  executable: true
  checksum:
    sha256: {{ .sha256 | quote }}
.config/zsh/completions/_mise:
  type: file
  url: https://github.com/jdx/mise/releases/download/{{ .version }}/mise.zsh
  checksum:
    sha256: {{ .completions_sha256 | quote }}
{{- end }}
{{- end }}
