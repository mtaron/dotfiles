# Everything here is pinned to an immutable reference and verified by checksum.

{{- $zgenomVersion := "d99d5dc4b27695612de2b7054bb583dd19a7235d" }}
.local/share/zgenom:
  type: archive
  url: https://github.com/jandamm/zgenom/archive/{{ $zgenomVersion }}.tar.gz
  stripComponents: 1
  checksum:
    sha256: "e9ab0caa21bde4fa79c64962ff53d3fd1ae38283649b6b84c7a46200a1e6b2aa"

{{- $ohMyZshVersion := "083c339e0622bfc144b66ebf1a2e8dbe7d2ada0d" }}
.local/share/oh-my-zsh:
  type: archive
  url: https://github.com/ohmyzsh/ohmyzsh/archive/{{ $ohMyZshVersion }}.tar.gz
  stripComponents: 1
  checksum:
    sha256: "cb7965be44c410d99f734748db512d29c3c618b94dd4390045db7d42679c3ba6"
  exclude:
    - "*/themes"
    - "*/templates"
    - "*/.github"
    - "*/.devcontainer"

