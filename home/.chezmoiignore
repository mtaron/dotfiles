# .chezmoiignore matches agaist target locations, not source.
# https://www.chezmoi.io/reference/special-files-and-directories/chezmoiignore/

# Ubuntu specific ignores
{{ if not (eq .osid "linux-ubuntu") }}
.chezmoiscripts/ubuntu/**
{{- end }}

{{ if or (not (eq .osid "linux-ubuntu")) .headless -}}
.local/bin/kernel-clean
{{- end }}

# Application specific ignores
{{ if not (lookPath "gh") -}}
.local/bin/docker-credential-gh
.config/docker/config.json
{{- end }}

{{ if not (lookPath "terraform") -}}
.config/terraform/
{{- end }}
