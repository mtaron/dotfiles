#!/usr/bin/env bash

set -euo pipefail

{{ $bat_version := (gitHubLatestRelease "sharkdp/bat").TagName -}}

tmp_dir=$(mktemp --directory)
curl --show-error --silent --fail --location \
    --output "$tmp_dir"/bat.deb \
    "https://github.com/sharkdp/bat/releases/download/{{ $bat_version }}/bat_{{ trimPrefix "v" $bat_version }}_{{ .chezmoi.arch }}.deb"

sudo dpkg --install "$tmp_dir"/bat.deb

rm -rf "$tmp_dir"

echo "Installed bat $(bat --version)"
