#!/usr/bin/env sh

set -e

{{ $zoom_download := getRedirectedURL "https://zoom.us/client/latest/zoom_amd64.deb" -}}

tmp_dir=$(mktemp --directory)
curl --show-error --silent --fail --location "{{ $zoom_download }}" --output "$tmp_dir/zoom_amd64.deb"
sudo apt install "$tmp_dir/zoom_amd64.deb"
rm -rf "$tmp_dir"

