# Incrementally add history to $HISTFILE instead of waiting for shell exit.
# This allows for running 'exec zsh' without losing history.
setopt inc_append_history

export GPG_TTY=$TTY

# Disable Oh-My-ZSH's internal updating
zstyle ':omz:update' mode disabled

ZSH_COMPLETIONS="$ZDOTDIR/completions"
fpath=("$ZSH_COMPLETIONS" $fpath)

ZSH_AUTOSUGGEST_STRATEGY=(completion history)

# run zgenom reset automatically when this file changes
ZGEN_RESET_ON_CHANGE=("$ZDOTDIR/.zshrc")

# oh-my-zsh location (managed by chezmoi, see .chezmoiexternal.yaml.tmpl)
export ZSH="$XDG_DATA_HOME/oh-my-zsh"

# Load plugin manager
source "$XDG_DATA_HOME/zgenom/zgenom.zsh"

if ! zgenom saved; then
  # oh-my-zsh is installed by chezmoi as a pinned external, so it is loaded by
  # path rather than cloned by zgenom.
  zgenom load "$ZSH/oh-my-zsh.sh"

  zgenom load "$ZSH/plugins/zsh-syntax-highlighting"
  zgenom load "$ZSH/plugins/zsh-autosuggestions"

  zgenom load jirutka/zsh-shift-select zsh-shift-select.plugin.zsh da460999b7d31aef0f0a82a3e749d70edf6f2ef9 --pin
  zgenom load hlissner/zsh-autopair zsh-autopair.plugin.zsh 449a7c3d095bc8f3d78cf37b9549f8bb4c383f3d --pin
  zgenom load jandamm/zgenom-ext-eval init.zsh 5a439dbd02b9bbeb84df9a4d5f657d6aa02270ac --pin

  zgenom eval --name mise <<(mise activate zsh)
  zgenom eval --name starship <<(starship init zsh)
  zgenom eval --name zoxide <<(zoxide init zsh)
  zgenom eval --name atuin <<(atuin init zsh)

  zgenom load "$ZDOTDIR/zshrc.d"

  zgenom save
fi

# Dedupe paths using a ZSH builtin
# https://til.hashrocket.com/posts/7evpdebn7g-remove-duplicates-in-zsh-path
typeset -aU path fpath
